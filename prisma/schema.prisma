// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Append this model to the schema.prisma that ships with the Shopify Remix
// template (it already has a Session model — leave that as-is, just add this).

model ProductSnapshot {
  id                              String   @id @default(cuid())
  shop                            String // e.g. "your-store.myshopify.com"
  productId                       String
  title                           String
  currentInventory                Int
  unitsSoldLast7Days              Int
  unitsSoldPrevious30DaysDailyAvg Float
  daysSinceLastSale               Int
  updatedAt                       DateTime @updatedAt

  @@unique([shop, productId])
  @@index([shop])
}

// Populate this table via a nightly scheduled job (Remix + a cron trigger, or
// a simple GitHub Action hitting a webhook route) that:
//   1. Pulls each installed shop's orders (last 30 days) + inventory via Admin GraphQL
//   2. Aggregates into the fields above
//   3. Upserts one row per product per shop
// Keep the sync job separate from the request/response cycle — it should never
// run inline on a page load.

// Explicit "has a full catalogue sync ever completed for this shop" signal.
// Deliberately NOT inferred from ProductSnapshot row count — that breaks for
// a shop with a genuinely empty catalogue, where 0 rows is also the correct
// end state after a successful sync. Written only by syncShopInventory()
// (install-time backfill + daily cron), never by the single-product webhook
// handler — that's a partial update, not a full-catalogue baseline.
model ShopSyncStatus {
  shop         String   @id
  lastSyncedAt DateTime @default(now()) @updatedAt
}

// Dated ledger of individual sales, one row per (shop, product, order). This
// is the single source of truth for ProductSnapshot's unitsSoldLast7Days /
// unitsSoldPrevious30DaysDailyAvg — both syncShopInventory() (full catalogue
// sync) and the orders/paid webhook (single-product update) derive those
// fields from a real windowed SUM over this table, never from a running
// counter. A counter would need to "age out" old contributions at the 7-day
// boundary with no reliable way to do that correctly without per-event
// dates — this table IS those dates, so the window math is always exact
// regardless of how long it's been since the last successful full sync.
//
// @@unique on (shop, productId, orderId) makes ingestion idempotent against
// Shopify's at-least-once webhook delivery — a redelivered orders/paid for
// the same order upserts the same row instead of double-counting.
model ProductSaleEvent {
  id         String   @id @default(cuid())
  shop       String
  productId  String
  orderId    String
  quantity   Int
  occurredAt DateTime

  @@unique([shop, productId, orderId])
  @@index([shop, productId, occurredAt])
}

// Deliberately its own model, not a field on Session/ProductSnapshot/etc —
// those four are exactly what shop/redact deletes, and this timestamp needs
// to survive that deletion to be useful for confirming shop/redact's own
// 48-hour timing on a future backfill. One row per shop (upserted), tracking
// only the most recent uninstall — not a full install/uninstall history.
// See app/models/shop-uninstall.server.ts for the write path and the
// source-confidence rule (a "webhook" record is never downgraded by a later
// "cron_inferred" one).
model ShopUninstall {
  shop          String   @id
  uninstalledAt DateTime
  source        String // "webhook" | "cron_inferred"
}

